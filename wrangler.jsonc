// Konfigurasi Worker Lexa (Cloudflare Workers + Static Assets).
//
// Repo ini adalah sumber kebenaran untuk apa yang tercantum di bawah: setiap
// `wrangler deploy` (termasuk dari Workers Builds) menimpa pengaturan tersebut di
// Worker `lexa`. Yang SENGAJA tidak dicantumkan (nilainya hanya ada di dashboard)
// dijelaskan di bagian akhir berkas ini. Panduan lengkap:
// docs/hubungkan-github-cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexa",
  "main": "src/worker/index.ts",

  // Diperkirakan dari tanggal pembuatan Worker (5 Agu 2026). Kode tidak bergantung
  // pada perilaku yang berubah setelah tanggal ini.
  "compatibility_date": "2026-08-05",

  // Worker produksi mengunggah sourcemap (itulah sebabnya kode v0.1 bisa dipulihkan).
  "upload_source_maps": true,

  // Pertahankan variabel teks yang diset lewat dashboard (EMBEDDING_MODEL,
  // SUMMARY_MODEL, BPK_BASE, PASAL_API_BASE, SEARCH_CACHE_TTL). Tanpa ini, deploy
  // dari Git akan MENGHAPUS variabel yang tidak tercantum di "vars". Nilainya
  // sengaja belum disalin ke sini karena tidak terbaca dari luar dashboard; setelah
  // Anda memindahkannya ke "vars", baris ini boleh dihapus. Secret (ADMIN_TOKEN,
  // PASAL_API_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) tidak pernah tersentuh
  // oleh deploy.
  "keep_vars": true,

  // --- Resource yang sudah ada di akun Cloudflare ---
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexa-db",
      "database_id": "5bafb2d1-b42c-4e5a-9bf3-735e2eb2c6b8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "4bba573824b4423d9a31a7b73e855eb1" }
  ],
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "lexa-pdfs" }
  ],
  "ai": { "binding": "AI" },

  // Indeks vektor per pasal: bge-m3 (1024 dimensi, cosine), metadata terindeks
  // `jenis` dan `status` (dipakai sebagai filter pencarian makna).
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "lexa-index" }
  ],

  // Antrean ingest. Hanya sisi produsen yang dideklarasikan: konsumernya sudah
  // terpasang ke Worker ini, dan pengaturannya (ukuran batch, jumlah percobaan ulang,
  // jeda, konkurensi, dead-letter queue lexa-ingest-dlq) dikelola di dashboard
  // (Queues > lexa-ingest > Settings). Mendeklarasikan "consumers" di sini akan
  // menimpa pengaturan itu dengan nilai bawaan.
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "lexa-ingest" }]
  },

  // Cron harian pukul 19:00 UTC (02:00 WIB): log sinkronisasi produksi menunjukkan
  // eksekusi pada jam itu setiap hari.
  "triggers": { "crons": ["0 19 * * *"] },

  // Antarmuka (SPA) ada di ./public dan tidak memerlukan langkah build. Rute yang
  // diselesaikan Worker lebih dulu: seluruh API serta robots.txt dan sitemap.xml;
  // sisanya dilayani sebagai aset statis, dengan fallback ke index.html agar rute
  // sisi klien (/cari, /peraturan?uri=..., dst.) bisa dibuka langsung. Akibat dari
  // run_worker_first berupa daftar: jalur yang tak cocok dengan aset apa pun, termasuk
  // berkas yang salah ketik, dijawab index.html (200), bukan 404 (diverifikasi di workerd).
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml"]
  }

  // Tidak dicantumkan karena nilai live tidak terlihat dari luar dashboard, dan
  // menimpanya dengan tebakan lebih berbahaya daripada membiarkannya apa adanya:
  //   - observability / logs, placement, limits (cpu_ms), compatibility_flags
  //   - route / custom domain
  // Bila ingin dikelola dari Git, tambahkan di sini setelah mencocokkannya dengan
  // dashboard (Workers & Pages > lexa > Settings).
}
