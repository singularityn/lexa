{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true
  },
  "include": [
    "src",
    "test",
    "scripts"
  ],
  // Tes modul peramban butuh pustaka DOM; diperiksa oleh tsconfig.web.json.
  "exclude": [
    "node_modules",
    "test/browser"
  ]
}
