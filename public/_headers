# Header untuk aset statis (Workers Static Assets). Respons /api/* mendapat header
# keamanannya dari Worker (src/worker/index.ts).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Service worker dan manifest harus selalu divalidasi ke server: salinan usang akan menahan
# pengguna di rilis lama (Workers Static Assets sudah memakai max-age=0, ini membuatnya eksplisit).
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
