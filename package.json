{
  "name": "lexa",
  "version": "0.2.0",
  "private": true,
  "description": "Lexa: pencarian dan penelusuran peraturan perundang-undangan Indonesia di atas Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist-check",
    "d1:migrate:local": "wrangler d1 migrations apply lexa-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply lexa-db --remote",
    "dev:node": "npm run build:dev --silent && node .dev/dev-node.mjs",
    "build:dev": "esbuild scripts/dev-node.ts --bundle --platform=node --format=esm --target=node22 --outfile=.dev/dev-node.mjs --log-level=warning",
    "sw": "node scripts/perbarui-sw.mjs",
    "ikon": "node scripts/buat-ikon.mjs",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
