{
  "name": "lexa",
  "version": "0.1.0",
  "private": true,
  "description": "Lexa: pencarian dan penelusuran peraturan perundang-undangan Indonesia di atas Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist-check",
    "d1:migrate:local": "wrangler d1 migrations apply lexa-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply lexa-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
