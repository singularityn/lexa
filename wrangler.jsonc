// Konfigurasi Worker Lexa (Cloudflare Workers + Static Assets).
//
// Repo ini adalah sumber kebenaran untuk apa yang tercantum di bawah: setiap
// `wrangler deploy` (termasuk dari Workers Builds) menimpa pengaturan tersebut di
// Worker `lexa`. Yang SENGAJA tidak dicantumkan (nilainya hanya ada di dashboard)
// dijelaskan di bagian akhir berkas ini. Panduan lengkap:
// docs/hubungkan-github-cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexa",
  "main": "src/worker/index.ts",

  // Diperkirakan dari tanggal pembuatan Worker (5 Agu 2026). Kode tidak bergantung
  // pada perilaku yang berubah setelah tanggal ini.
  "compatibility_date": "2026-08-05",

  // Worker produksi mengunggah sourcemap (itulah sebabnya kode v0.1 bisa dipulihkan).
  "upload_source_maps": true,

  // Pertahankan variabel teks yang diset lewat dashboard (EMBEDDING_MODEL,
  // SUMMARY_MODEL, BPK_BASE, SEARCH_CACHE_TTL). Tanpa ini, deploy
  // dari Git akan MENGHAPUS variabel yang tidak tercantum di "vars". Nilainya
  // sengaja belum disalin ke sini karena tidak terbaca dari luar dashboard; setelah
  // Anda memindahkannya ke "vars", baris ini boleh dihapus. Secret (ADMIN_TOKEN,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, dan GEMINI_API, kunci opsional untuk membaca PDF pindaian, lib/gemini.ts) tidak
  // pernah tersentuh oleh deploy. Variabel opsional GEMINI_MODEL, GEMINI_BATAS_HARIAN, GEMINI_BASE_URL, dan GEMINI_OTOMATIS (beserta
  // GEMINI_OTOMATIS_BATAS, GEMINI_OTOMATIS_UJI_MAKS, GEMINI_OTOMATIS_VONIS) juga hanya ada di dashboard.
  // Sisa pengaturan sumber lama di dashboard (variabel PASAL_API_BASE dan TIK_CADANGAN, secret
  // PASAL_API_TOKEN) tidak dibaca kode lagi dan boleh dihapus dari sana.
  "keep_vars": true,

  // Cakupan peraturan (src/shared/cakupan.ts): kode jenis seperti kolom laws.jenis, dipisah koma.
  // Untuk saat ini hanya UUD dan setara (Tap MPR), UU termasuk Perppu, dan PP, supaya beban aplikasi tetap
  // ringan. Jenis lain tidak diimpor, dicari, maupun ditampilkan; barisnya yang sudah ada hanya disembunyikan,
  // bukan dihapus. Melebarkan cakupan: tambahkan kodenya di sini (mis. "...,PP,PERPRES"), sebarkan, lalu jalankan
  // penjelajahan dan panen BPK untuk jenis itu. Nilai kosong atau tak sah dibaca sebagai daftar bawaan di kode.
  "vars": {
    "CAKUPAN_JENIS": "UUD,TAP_MPR,UU,PERPPU,PP"
  },

  // --- Resource yang sudah ada di akun Cloudflare ---
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexa-db",
      "database_id": "5bafb2d1-b42c-4e5a-9bf3-735e2eb2c6b8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "4bba573824b4423d9a31a7b73e855eb1" }
  ],
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "lexa-pdfs" }
  ],
  "ai": { "binding": "AI" },

  // Indeks vektor per pasal: bge-m3 (1024 dimensi, cosine), metadata terindeks
  // `jenis` dan `status` (dipakai sebagai filter pencarian makna).
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "lexa-index" }
  ],

  // Antrean ingest. Hanya sisi produsen yang dideklarasikan: konsumernya sudah
  // terpasang ke Worker ini, dan pengaturannya (ukuran batch, jumlah percobaan ulang,
  // jeda, konkurensi, dead-letter queue lexa-ingest-dlq) dikelola di dashboard
  // (Queues > lexa-ingest > Settings). Mendeklarasikan "consumers" di sini akan
  // menimpa pengaturan itu dengan nilai bawaan.
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "lexa-ingest" }]
  },

  // Dua pemicu Cron:
  //   - "0 19 * * *" (harian, 02:00 WIB): pemeliharaan (src/worker/lib/pemeliharaan.ts): mengosongkan daftar hapus (berkas R2
  //     dan vektor yatim) dan memangkas catatan lama;
  //   - "*/15 * * * *" (tiap 15 menit): Gemini otomatis (src/worker/lib/geminiOtomatis.ts). Tak mengerjakan apa pun, dan tak
  //     menyentuh D1 maupun Gemini, kecuali variabel GEMINI_OTOMATIS dipasang di dashboard ("uji" atau "ya").
  // Data peraturan tidak dijemput Cron: ia masuk dari panen BPK yang dijalankan di peramban pengelola
  // (scripts/bpk-console-harvest.js) lewat /api/impor/*. Nilainya dijaga sama dengan src/worker/lib/jadwal.ts oleh
  // test/cakupan.test.ts.
  "triggers": { "crons": ["0 19 * * *", "*/15 * * * *"] },

  // Lokasi eksekusi Worker (hanya penangan `fetch`, yaitu API dan semua rute di bawah "run_worker_first"; antrean dan Cron tidak
  // terpengaruh, dan aset statis tetap dilayani dari pusat data terdekat dengan pembaca). Tanpa ini Worker berjalan di pusat data
  // terdekat dengan pemanggil, dan dari Asia Tenggara itu bisa Singapura atau Hong Kong: Google menilai lokasi dari alamat IP keluar
  // dan menjawab Gemini dengan 400 "User location is not supported for the API use" dari sebagian pusat data itu. Wilayah AS Timur
  // sekaligus dekat dengan D1 (lexa-db berada di ENAM), jadi pemanggilan D1 beruntun dalam satu permintaan menjadi jauh lebih cepat.
  // Pembaca di Indonesia menambah satu perjalanan ke AS per permintaan API; berkas statis tidak.
  "placement": { "region": "aws:us-east-1" },

  // Antarmuka (SPA) ada di ./public dan tidak memerlukan langkah build. Rute yang
  // diselesaikan Worker lebih dulu: seluruh API, robots.txt, sitemap.xml, dan /peraturan
  // (cangkang SPA; untuk perayap dan aplikasi pesan ditambah judul, deskripsi, dan gambar
  // pratinjau tautan, lihat src/worker/lib/pratinjau.ts, yang jatuh ke cangkang biasa
  // bila apa pun gagal; pembaca biasa langsung menerima cangkang tanpa menyentuh D1);
  // sisanya dilayani sebagai aset statis, dengan fallback ke index.html agar rute
  // sisi klien (/cari, /telusuri, dst.) bisa dibuka langsung. Akibat dari
  // run_worker_first berupa daftar: jalur yang tak cocok dengan aset apa pun, termasuk
  // berkas yang salah ketik, dijawab index.html (200), bukan 404 (diverifikasi di workerd).
  // Binding ASSETS memberi Worker akses ke berkas statis itu.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml", "/peraturan"]
  }

  // Tidak dicantumkan karena nilai live tidak terlihat dari luar dashboard, dan
  // menimpanya dengan tebakan lebih berbahaya daripada membiarkannya apa adanya:
  //   - observability / logs, limits (cpu_ms), compatibility_flags
  //   - route / custom domain
  // Bila ingin dikelola dari Git, tambahkan di sini setelah mencocokkannya dengan
  // dashboard (Workers & Pages > lexa > Settings).
}
